        "jsCode": "const raw = ($json.output ?? '').toString().replace(/```(?:json)?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch {\n  parsed = { score: 0, matchReason: 'AI output parse failed', coverLetter: raw };\n}\n\nconst score = Number(parsed.score ?? 0);\n\nreturn {\n  score: Number.isFinite(score) ? score : 0,\n  matchReason: (parsed.matchReason ?? 'No reason provided').toString(),\n  coverLetter: (parsed.coverLetter ?? '').toString(),\n};"
