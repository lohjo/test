    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\n\nconst keyword = (row.Keyword ?? '').toString().trim();\nconst location = (row.Location ?? '').toString().trim();\nconst experienceLevel = (row['Experience Level'] ?? '').toString().trim();\nconst remote = (row.Remote ?? '').toString().trim();\nconst jobType = (row['Job Type'] ?? '').toString().trim();\nconst easyApply = (row['Easy Apply'] ?? '').toString().trim().toLowerCase();\n\nlet linkedinUrl = 'https://www.linkedin.com/jobs/search/?f_TPR=r1209600';\n\nif (keyword) {\n  linkedinUrl += `&keywords=${encodeURIComponent(keyword)}`;\n}\n\nif (location) {\n  linkedinUrl += `&location=${encodeURIComponent(location)}`;\n}\n\nif (experienceLevel) {\n  const transformedExperiences = experienceLevel\n    .split(',')\n    .map((exp) => {\n      switch (exp.trim()) {\n        case 'Internship': return '1';\n        case 'Entry level': return '2';\n        case 'Associate': return '3';\n        case 'Mid-Senior level': return '4';\n        case 'Director': return '5';\n        case 'Executive': return '6';\n        default: return '';\n      }\n    })\n    .filter(Boolean);\n\n  if (transformedExperiences.length) {\n    linkedinUrl += `&f_E=${transformedExperiences.join(',')}`;\n  }\n}\n\nif (remote) {\n  const transformedRemote = remote\n    .split(',')\n    .map((e) => {\n      switch (e.trim()) {\n        case 'Remote': return '2';\n        case 'Hybrid': return '3';\n        case 'On-Site': return '1';\n        default: return '';\n      }\n    })\n    .filter(Boolean);\n\n  if (transformedRemote.length) {\n    linkedinUrl += `&f_WT=${transformedRemote.join(',')}`;\n  }\n}\n\nif (jobType) {\n  const transformedJobType = jobType\n    .split(',')\n    .map((type) => {\n      const normalized = type.trim().toLowerCase();\n      switch (normalized) {\n        case 'full-time': return 'F';\n        case 'part-time': return 'P';\n        case 'contract': return 'C';\n        case 'temporary': return 'T';\n        case 'internship': return 'I';\n        case 'other': return 'O';\n        case 'volunteer': return 'V';\n        default: return '';\n      }\n    })\n    .filter(Boolean);\n\n  if (transformedJobType.length) {\n    linkedinUrl += `&f_JT=${transformedJobType.join(',')}`;\n  }\n}\n\nif (['true', 'yes', '1'].includes(easyApply)) {\n  linkedinUrl += '&f_EA=true';\n}\n\nlet mcfUrl = 'https://www.mycareersfuture.gov.sg/search?sortBy=new_posting_date';\nif (keyword) {\n  mcfUrl += `&search=${encodeURIComponent(keyword)}`;\n}\nif (location) {\n  mcfUrl += `&location=${encodeURIComponent(location)}`;\n}\n\nreturn [\n  { url: linkedinUrl, source: 'linkedin' },\n  { url: mcfUrl, source: 'mcf' },\n];"
      },
